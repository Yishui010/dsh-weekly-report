{
  "name": "dsh-plugin-weekly",
  "version": "0.1.0",
  "private": true,
  "description": "Weekly report for DSH: collect a week of DSH sessions plus manually recorded work, draft a four-section report with the configured model, review it in Settings, and send it by WeCom mail.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.1.5-alpha.1"
  }
}
